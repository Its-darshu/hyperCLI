{
    "label" : "lock",
    "action" : "pidof hyprlock || hyprlock",
    "text" : "󰌾\nLock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch exit",
    "text" : "󰍃\nLogout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "󰏤\nSleep",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "\nReboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "󰐥\nShutdown",
    "keybind" : "p"
}
{
    "label" : "firmware",
    "action" : "systemctl reboot --firmware-setup",
    "text" : "󰘚\nUEFI",
    "keybind" : "b"
}
