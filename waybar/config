{
    "layer": "top",
    "position": "bottom",
    "exclusive": true,
    "start_hidden": false,
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 4,
    "reload_style_on_change": true,
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "temperature",
        "power-profiles-daemon",
        "network",
        "bluetooth",
        "backlight",
        "wireplumber",
        "battery",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1",
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [
                1,
                2,
                3,
                4,
                5
            ]
        }
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "Terminal": "󰆍  Terminal",
            "": "󰍹  Desktop"
        }
    },
    "clock": {
        "format": "󰅐  {0:%I:%M %p}   󰃭  {0:%a %d %b}",
        "tooltip-format": "<big>{0:%Y %B}</big>\n<tt><small>{0:%A, %d %B %Y}</small></tt>",
        "on-click": "xdg-open https://calendar.google.com"
    },
    "cpu": {
        "interval": 2,
        "format": "󰻠  {usage}%",
        "tooltip": true,
        "on-click": "gnome-terminal -- top"
    },
    "memory": {
        "interval": 5,
        "format": "󰍛  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G   ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "on-click": "gnome-terminal -- top"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "interval": 2,
        "critical-threshold": 85,
        "format": "{icon}  {temperatureC}°C",
        "format-critical": "{icon}  {temperatureC}°C",
        "format-icons": [
            "󰔐",
            "󰔏",
            "󰔏",
            "󰔑",
            "󰔑"
        ],
        "tooltip": true
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Power mode: {profile}\nClick to switch (saver → balanced → performance)",
        "format-icons": {
            "default": "󰓅",
            "power-saver": "󰌪",
            "balanced": "󰗑",
            "performance": "󱓞"
        }
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-linked": "󰖩",
        "tooltip-format-wifi": "󰖩  {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}",
        "tooltip-format-ethernet": "󰈀  {ifname}\nIP: {ipaddr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "on-click-right": "~/.config/hypr/scripts/wifi-toggle.sh toggle",
        "max-length": 20
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "format-off": "󰂲",
        "tooltip-format": "Bluetooth: {status}\n{controller_alias}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_address}  {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "~/.config/hypr/scripts/bt-toggle.sh scan",
        "on-click-middle": "~/.config/hypr/scripts/bt-toggle.sh toggle"
    },
    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃛",
            "󰃜",
            "󰃝",
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
        "tooltip": true,
        "tooltip-format": "Screen brightness: {percent}%"
    },
    "wireplumber": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": [
            "󰕿",
            "󰖀",
            "󰕾"
        ],
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip": true,
        "tooltip-format": "Volume: {volume}%\nNode: {node_name}"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%",
        "format-full": "󰁹  {capacity}%",
        "format-icons": [
            "󰁻",
            "󰁽",
            "󰁿",
            "󰂁",
            "󰁹"
        ],
        "tooltip-format": "Battery: {capacity}%\nHealth: {health}%\n{timeTo}\nPower draw: {power}W"
    },
    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout -b 6 -T 390 -B 390 -L 200 -R 200 -c 15"
    }
}
