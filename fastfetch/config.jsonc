// Classic neofetch layout: distro logo left, "Key: value" right, color blocks below.
// Previous JaKooLit config kept as config-jakoolit.jsonc — run it with:
//   fastfetch -c ~/.config/fastfetch/config-jakoolit.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // Auto-detects Fedora. Use "source": "arch" (etc.) to force another distro.
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": ": ",
    "key": { "width": 0 },
    "color": { "keys": "blue", "title": "blue" }
  },

  "modules": [
    { "type": "title", "format": "{user-name}@{host-name}" },
    "separator",

    { "type": "os",       "key": "OS" },
    { "type": "host",     "key": "Host" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory" },
    { "type": "swap",     "key": "Swap" },
    { "type": "localip",  "key": "Local IP" },
    { "type": "battery",  "key": "Battery" },
    { "type": "locale",   "key": "Locale" },

    // Extras — uncomment any you want back:
    // { "type": "wm",     "key": "WM" },
    // { "type": "disk",   "key": "Disk" },
    // "break",
    // { "type": "colors", "paddingLeft": 2, "symbol": "block" }
  ]
}
