// Classic neofetch layout: distro logo left, "Key: value" right, color blocks below.
// Previous JaKooLit config kept as config-jakoolit.jsonc — run it with:
//   fastfetch -c ~/.config/fastfetch/config-jakoolit.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // The full "Fedora" logo is ~20 lines and ate most of the terminal on launch.
    // "Fedora_small" is the same f-mark at half the height. `fastfetch --list-logos`
    // shows the rest; use "source": "arch" (etc.) to force another distro.
    "source": "Fedora_small",
    // Both ASCII colour slots forced to red so the mark is a single flat colour.
    "color": { "1": "red", "2": "red" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": ": ",
    "key": { "width": 0 },
    "color": { "keys": "red", "title": "red" }
  },

  "modules": [
    // No "format" override here — a custom format string bypasses display.color.title,
    // and the default output is already user@host.
    { "type": "title" },
    "separator",

    { "type": "os",       "key": "OS" },
    { "type": "host",     "key": "Host" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "packages", "key": "Packages" },
    { "type": "shell",    "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory" },
    { "type": "swap",     "key": "Swap" },
    { "type": "localip",  "key": "Local IP" },
    { "type": "battery",  "key": "Battery" },
    { "type": "locale",   "key": "Locale" },

    // Extras — uncomment any you want back:
    // { "type": "wm",     "key": "WM" },
    // { "type": "disk",   "key": "Disk" },
    // "break",
    // { "type": "colors", "paddingLeft": 2, "symbol": "block" }
  ]
}
